# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Application ---
# One of: development, test, production
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose creates the database from these) ---
POSTGRES_USER=revision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=revision_os

# Used when running the API on the host (outside Docker). Inside Docker
# compose overrides the host part to `db`.
DATABASE_URL=postgresql+asyncpg://revision:change-me@localhost:5432/revision_os

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Anthropic (needed from Phase 5; leave blank until then) ---
# Keep the key here only. Do NOT export ANTHROPIC_API_KEY in your shell:
# Claude Code would then bill that key instead of your Pro plan.
ANTHROPIC_API_KEY=

# --- Web Push (Phase 11; optional) ---
# `make vapid-keys` generates the pair and writes them here (in .env).
# Push is off until all three are set. The subject is a contact address for
# the push services, e.g. mailto:you@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

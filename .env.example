# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Application ---
# One of: development, test, production
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose creates the database from these) ---
POSTGRES_USER=revision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=revision_os

# Used when running the API on the host (outside Docker). Inside Docker
# compose overrides the host part to `db`.
DATABASE_URL=postgresql+asyncpg://revision:change-me@localhost:5432/revision_os

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Anthropic (needed from Phase 5; leave blank until then) ---
# Keep the key here only. Do NOT export ANTHROPIC_API_KEY in your shell:
# Claude Code would then bill that key instead of your Pro plan.
ANTHROPIC_API_KEY=

# --- Web Push (Phase 11; optional) ---
# `make vapid-keys` generates the pair and writes them here (in .env).
# Push is off until all three are set. The subject is a contact address for
# the push services, e.g. mailto:you@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- File storage ---
# "local" keeps uploads on disk (in Docker, a volume). When deployed you can
# use a private S3-compatible bucket instead (Cloudflare R2, Backblaze B2):
# STORAGE_BACKEND=s3 and the S3_* settings (docs/deployment.md).
STORAGE_BACKEND=local
S3_BUCKET=
# R2: https://<account id>.r2.cloudflarestorage.com (blank for AWS S3)
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Production only (infra/docker-compose.prod.yml; docs/deployment.md) ---
# Your site's name; Caddy gets an HTTPS certificate for it by itself.
DOMAIN=
# Daily database dumps in ./backups are kept this many days.
BACKUP_KEEP_DAYS=14
